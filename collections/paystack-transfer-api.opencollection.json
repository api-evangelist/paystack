          },
          "http": {
            "method": "POST",
            "url": "https://api.paystack.co/transfer/disable_otp_finalize",
            "body": {
              "type": "json",
              "data": "{}"
            }
          },
          "docs": "Finalize Disabling of OTP requirement for Transfers"
        },
        {
          "info": {
            "name": "Enable OTP requirement for Transfers",
            "type": "http"
          },
          "http": {
            "method": "POST",
            "url": "https://api.paystack.co/transfer/enable_otp"
