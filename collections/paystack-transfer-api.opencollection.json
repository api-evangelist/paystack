{
  "opencollection": "1.0.0",
  "info": {
    "name": "Paystack Accept Payments Balance Transfer API",
    "version": "1.0.0"
  },
  "request": {
    "auth": {
      "type": "bearer",
      "token": "{{bearerToken}}"
    }
  },
  "items": [
    {
      "info": {
        "name": "Transfer",
        "type": "folder"
      },
      "items": [
