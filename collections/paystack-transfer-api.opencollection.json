            "type": "http"
          },
          "http": {
            "method": "GET",
            "url": "https://api.paystack.co/transfer",
            "params": [
              {
                "name": "perPage",
                "value": "",
                "type": "query",
                "description": "Number of records to fetch per page"
              },
              {
                "name": "page",
                "value": "",
                "type": "query",
                "description": "The section to retrieve"
              },
              {
                "name": "status",
                "value": "",
                "type": "query"
              },
              {
                "name": "from",
                "value": "",
                "type": "query",
                "description": "The start date"
              },
              {
                "name": "to",
                "value": "",
